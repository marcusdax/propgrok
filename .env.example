# Environment variables for PropertyInsight
# Copy this to .env and fill in the values

# Database connection (used when not using Docker compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/propertyinsight

# xAI API key for AI features (get from https://x.ai/)
XAI_API_KEY=your_xai_api_key_here

# Auth settings (set to true for production)
VITE_AUTH_ENABLED=true

# Application URL (for emails, redirects, etc.)
APP_URL=http://localhost:8080

# Feature flags
VITE_FEATURE_MAP_INTELLIGENCE=true
VITE_FEATURE_DEMOGRAPHIC_HEATMAP=true