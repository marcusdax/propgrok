# PropertyInsight - Development Docker image with hot reloading
FROM node:22-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
ENV GROK_ALLOW_INSTALL_SCRIPTS=1
RUN npm ci --no-audit --no-fund

# Copy scripts and migrations
COPY scripts ./scripts
COPY migrations ./migrations

# Expose ports
EXPOSE 8080 9229

# Start with dev server
CMD ["npm", "run", "dev"]